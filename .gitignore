# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
.venv/

# Regenerable data (chains, canonical lists) — excluded because they can
# exceed 100 MB at higher levels. Regenerate with caugjam.generate_poda,
# or point $SW_DATA_DIR at a pre-generated cache.
data/*
!data/README.md
!data/summary/
!data/summary/*.tsv
!data/fibration/
data/fibration/*
!data/fibration/README.md

# caugJAM / canonJAM (installed from GitHub)
caugjam/
canonjam/
